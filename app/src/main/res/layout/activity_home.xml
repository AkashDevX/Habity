<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_purple"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Progress Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_goal"
                    android:textSize="16sp"
                    android:textColor="@color/text_white_secondary"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:id="@+id/textViewProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ml / 2000 ml"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/card_purple_light"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textViewRemaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Remaining: 2000 ml"
                        android:textSize="14sp"
                        android:textColor="@color/text_white_secondary"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="400" />

                    <TextView
                        android:id="@+id/textViewStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on_track"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="700" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Quick Add Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_add"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <LinearLayout
                    android:id="@+id/quickAddLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <!-- Buttons will be added programmatically -->

                </LinearLayout>

                <Button
                    android:id="@+id/buttonCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/custom_amount"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/primary"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="600" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Hydration Tip Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="💡"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/textViewTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Stay hydrated throughout the day!"
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Today's Logs Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today_logs"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/font_family_poppins"
            android:fontWeight="700" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            tools:listitem="@layout/item_water_entry" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:text="💧"
                android:textSize="80sp"
                android:gravity="center"
                android:background="@drawable/icon_background_blue"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_logs_today"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="700"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start tracking your water intake today!"
                android:textSize="16sp"
                android:textColor="@color/text_white_secondary"
                android:gravity="center"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="400" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

