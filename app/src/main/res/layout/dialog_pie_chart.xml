<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_purple">

    <TextView
        android:id="@+id/textViewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date: Today"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_white"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/font_family_poppins"
        android:fontWeight="700" />

    <com.cleverkube.watermark.view.PieChartView
        android:id="@+id/pieChartView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textViewStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consumed: 0 ml / Goal: 2000 ml"
        android:textSize="16sp"
        android:textColor="@color/text_white_secondary"
        android:layout_gravity="center"
        android:fontFamily="@font/font_family_poppins"
        android:fontWeight="400" />

</LinearLayout>


