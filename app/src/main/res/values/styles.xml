<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card Styles -->
    <style name="CardTile">
        <item name="android:layout_margin">8dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/font_family_poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:fontWeight">700</item>
    </style>
    
    <style name="TextSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/font_family_poppins</item>
        <item name="android:textColor">@color/text_white_secondary</item>
        <item name="android:fontWeight">400</item>
    </style>
    
    <!-- Button Styles -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/font_family_poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontWeight">700</item>
        <item name="android:padding">16dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="AboutRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/font_family_poppins</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontWeight">400</item>
    </style>

</resources>

