<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_purple"
    tools:context=".PrivacyPolicyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Policy"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last updated: January 2024"
                    android:textSize="12sp"
                    android:textColor="@color/text_white_secondary"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Collection"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WaterMark collects and stores your water intake data locally on your device. All data is stored offline and is never transmitted to external servers. We do not collect any personal information, location data, or usage analytics."
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Storage"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All your water intake records, goals, and settings are stored locally on your device using Android's Room database. This data remains on your device and is not accessible to us or any third parties."
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permissions"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WaterMark requires the following permissions:\n\n• Notification Permission: To send reminder notifications for water intake\n• Boot Completed Permission: To reschedule reminders after device restart\n\nThese permissions are used solely for the app's core functionality and are not used for tracking or data collection."
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Export/Import"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You can export your data to a JSON file at any time through the Settings screen. This export is stored locally on your device and can be imported back into the app. The export/import feature uses Android's Storage Access Framework and does not involve any external services."
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If you have any questions about this Privacy Policy, please contact us through the app's support channels."
                    android:textSize="14sp"
                    android:textColor="@color/text_white_secondary"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>


