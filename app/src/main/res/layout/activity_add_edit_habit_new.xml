<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_purple"
    tools:context=".AddEditHabitActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Habit Name Section -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Habit Name"
            android:layout_marginBottom="20dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:hintTextColor="@color/text_white_secondary"
            app:boxBackgroundColor="@color/card_purple"
            app:boxBackgroundMode="filled">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="16sp"
                android:textColor="@color/text_white"
                android:padding="16dp"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="400" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Habit Enabled Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Habit Enabled"
                android:textSize="16sp"
                android:textColor="@color/text_white"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="400" />

            <Switch
                android:id="@+id/switchHabitEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enabled"
                android:textColor="@color/text_white"
                android:thumbTint="@color/primary"
                android:trackTint="@color/card_purple_light" />

        </LinearLayout>

        <!-- Reminders Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reminders"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/font_family_poppins"
            android:fontWeight="700" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_reminder_inline" />

        <Button
            android:id="@+id/buttonAddReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ ADD REMINDER TIME"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/card_purple"
            android:padding="14dp"
            android:fontFamily="@font/font_family_poppins"
            android:fontWeight="700"
            app:cornerRadius="12dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Habit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"
            android:fontFamily="@font/font_family_poppins"
            android:fontWeight="700"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

