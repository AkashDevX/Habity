<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_purple"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline"
                android:textSize="16sp"
                android:textColor="@color/text_white_secondary"
                android:gravity="center"
                android:fontFamily="@font/font_family_poppins"
                android:fontWeight="400" />

        </LinearLayout>

        <!-- Row 1: Today and Calendar -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/tileToday"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@animator/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:text="💧"
                            android:textSize="40sp"
                            android:gravity="center"
                            android:background="@drawable/icon_background_blue"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Track your water intake"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="400" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tileCalendar"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:text="📆"
                            android:textSize="40sp"
                            android:gravity="center"
                            android:background="@drawable/icon_background_blue"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/history"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View past days"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="400" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Row 2: Stats and About -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/tileStats"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:text="📊"
                            android:textSize="40sp"
                            android:gravity="center"
                            android:background="@drawable/icon_background_purple"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Charts and insights"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="400" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tileSettings"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:text="⚙️"
                            android:textSize="40sp"
                            android:gravity="center"
                            android:background="@drawable/icon_background_purple"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_white"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Configure app settings"
                            android:textSize="15sp"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="none"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/font_family_poppins"
                            android:fontWeight="400" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Row 3: About -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tileAbout"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_purple"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="48sp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About WaterMark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
