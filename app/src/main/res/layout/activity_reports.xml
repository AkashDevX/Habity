<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_purple"
    tools:context=".ReportsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Total -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Intake"
                    android:textSize="16sp"
                    android:textColor="@color/text_white_secondary"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="400" />

                <TextView
                    android:id="@+id/textViewTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ml"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:fontFamily="@font/font_family_poppins"
                    android:fontWeight="700" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Stats Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average"
                        android:textSize="14sp"
                        android:textColor="@color/text_white_secondary"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="400" />

                    <TextView
                        android:id="@+id/textViewAverage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ml"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Days Met Goal"
                        android:textSize="14sp"
                        android:textColor="@color/text_white_secondary"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="400" />

                    <TextView
                        android:id="@+id/textViewDaysMet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 7"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Min/Max Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum"
                        android:textSize="14sp"
                        android:textColor="@color/text_white_secondary"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="400" />

                    <TextView
                        android:id="@+id/textViewMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ml"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_purple">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimum"
                        android:textSize="14sp"
                        android:textColor="@color/text_white_secondary"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="400" />

                    <TextView
                        android:id="@+id/textViewMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ml"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white"
                        android:fontFamily="@font/font_family_poppins"
                        android:fontWeight="700" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>


