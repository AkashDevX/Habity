<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PasswordManager">
        
        <activity
            android:name="com.passwordmanager.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name="com.passwordmanager.app.PinSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.PasswordManager" />
        
        <activity
            android:name="com.passwordmanager.app.PinLockActivity"
            android:exported="false"
            android:theme="@style/Theme.PasswordManager" />
        
        <activity
            android:name="com.passwordmanager.app.PasswordListActivity"
            android:exported="false"
            android:parentActivityName="com.passwordmanager.app.MainActivity" />
        
        <activity
            android:name="com.passwordmanager.app.AddEditPasswordActivity"
            android:exported="false"
            android:parentActivityName="com.passwordmanager.app.PasswordListActivity" />
        
        <activity
            android:name="com.passwordmanager.app.CategoriesActivity"
            android:exported="false"
            android:parentActivityName="com.passwordmanager.app.PasswordListActivity" />
    </application>

</manifest>
